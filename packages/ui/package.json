{
  "name": "@bayramm/ui",
  "private": true,
  "type": "module",
  "description": "Дизайн-токены Bayramm: палитра двух тем, шкалы, движение, безопасные зоны; свои шрифты (woff2). Экспортирует исходники TS и CSS, сборки нет.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "css": "vitest run -u src/tokens.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  }
}
