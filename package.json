{
  "name": "bayramm",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --filter './apps/*' --filter './packages/*' --filter ./e2e typecheck",
    "build": "pnpm -r --filter './apps/*' build",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @bayramm/e2e e2e",
    "dev:web": "pnpm --filter @bayramm/web dev",
    "dev:vendor": "pnpm --filter @bayramm/vendor dev",
    "dev:admin": "pnpm --filter @bayramm/admin dev",
    "dev:api": "pnpm --filter @bayramm/api dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14"
  }
}
