{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bayramm-vendor-dev",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Воркер решает первым: /api/* не должен уходить в SPA, HTML — без заголовков безопасности
    "run_worker_first": true
  },
  "services": [{ "binding": "API", "service": "bayramm-api-dev" }],
  "env": {
    "staging": {
      "name": "bayramm-vendor-staging",
      "routes": [{ "pattern": "vendor-staging.bayramm.uz", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "bayramm-api-staging" }]
    },
    "production": {
      "name": "bayramm-vendor",
      "routes": [{ "pattern": "vendor.bayramm.uz", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "bayramm-api" }]
    }
  }
}
