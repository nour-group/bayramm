{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bayramm-web-dev",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Workers Logs: клиент — самое посещаемое приложение, и каждый файл статики проходит через
  // воркер (run_worker_first) — пишем каждый десятый запрос. Ошибки API — в логах API целиком
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Воркер решает первым: старые ссылки taklifnoma и /api/* не должны уходить в SPA
    "run_worker_first": true
  },
  "services": [{ "binding": "API", "service": "bayramm-api-dev" }],
  // SEARCH_INDEXING — пускать ли поисковики (on/off). Индексируется только боевой домен и только
  // с on: до запуска (каталог пуст, тексты согласий не утверждены) — off. Переменные окружениями
  // не наследуются — значение в каждом
  "vars": { "SEARCH_INDEXING": "off" },
  "env": {
    "staging": {
      "name": "bayramm-web-staging",
      "routes": [{ "pattern": "staging.bayramm.uz", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "bayramm-api-staging" }],
      "vars": { "SEARCH_INDEXING": "off" }
    },
    "production": {
      "name": "bayramm-web",
      "routes": [{ "pattern": "bayramm.uz", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "bayramm-api" }],
      "vars": { "SEARCH_INDEXING": "off" }
    }
  }
}
