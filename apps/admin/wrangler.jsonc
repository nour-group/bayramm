{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bayramm-admin-dev",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Только свои домены: ни *.workers.dev, ни preview-адресов версий. Вход — виджет Telegram
  // по приглашению, данные отдаёт только API за сессией сотрудника
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Воркер решает первым: /api/* не должен уходить в SPA, HTML — без заголовков безопасности
    "run_worker_first": true
  },
  "services": [{ "binding": "API", "service": "bayramm-api-dev" }],
  "env": {
    "staging": {
      "name": "bayramm-admin-staging",
      "workers_dev": false,
      "preview_urls": false,
      // Домен виджета входа: у бота staging в @BotFather /setdomain — этот же адрес
      "routes": [{ "pattern": "admin-staging.bayramm.uz", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "bayramm-api-staging" }]
    },
    "production": {
      "name": "bayramm-admin",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "admin.bayramm.uz", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "bayramm-api" }]
    }
  }
}
