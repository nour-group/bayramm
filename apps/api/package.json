{
  "name": "@bayramm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "wrangler types --env-file .dev.vars.example --check && tsc --noEmit",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "test": "vitest run",
    "db:types": "kysely-codegen"
  },
  "dependencies": {
    "@bayramm/tg": "workspace:*",
    "hono": "^4.13.8",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
