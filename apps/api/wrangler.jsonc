{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bayramm-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "APP_ENV": "local", "GIT_SHA": "dev" },
  // Локально — Postgres из `supabase start`; id нужен wrangler, но не используется
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8d7b2a9d39d340dda8dc6ad9bff2928d",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ],
  "env": {
    "staging": {
      "name": "bayramm-api-staging",
      "vars": { "APP_ENV": "staging", "GIT_SHA": "dev" },
      // Worker рядом с базой (Supabase, eu-central-1)
      "placement": { "region": "aws:eu-central-1" },
      "routes": [{ "pattern": "api-staging.bayramm.uz", "custom_domain": true }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8d7b2a9d39d340dda8dc6ad9bff2928d" }]
    },
    "production": {
      "name": "bayramm-api",
      "vars": { "APP_ENV": "production", "GIT_SHA": "dev" },
      "placement": { "region": "aws:eu-central-1" },
      "routes": [{ "pattern": "api.bayramm.uz", "custom_domain": true }],
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "975a9fcde5e74e938de35af3a965e37c" }]
    }
  }
}
