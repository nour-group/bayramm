# Секреты API для локального запуска: скопируйте в .dev.vars (он в .gitignore)
# и подставьте свои значения. Здесь — только имена, без настоящих значений.
# На staging/production — `wrangler secret put <ИМЯ> --env <окружение>`.
#
# Из этого файла `wrangler types` берёт имена секретов для типа Env
# (скрипты typecheck и cf-typegen в package.json).

# Токен бота, через которого открывается Mini App (от @BotFather). Им же проверяется
# вход сотрудников через виджет Telegram: у бота должен быть домен панели оператора (/setdomain).
# Имя бота нигде не вписано: API узнаёт его по токену (getMe) и отдаёт в GET /telegram/bot
TELEGRAM_BOT_TOKEN=

# Ключ для POST /telegram/sync — настройка бота из кода (команды, описания, кнопка меню),
# её вызывает деплой. Не короче 32 символов, например: openssl rand -hex 32.
# Тот же ключ — секрет TELEGRAM_SYNC_KEY в GitHub Environment окружения.
# Пусто — /telegram/sync отвечает 404: локально его можно не задавать
TELEGRAM_SYNC_KEY=

# Ключ HMAC для псевдонимов: app.clients.tg_id_hash = HMAC-SHA256(ID_HASH_KEY, Telegram ID).
# Не короче 32 символов, например: openssl rand -base64 32
# После запуска не менять: со сменой ключа клиенты не найдутся по старым хэшам.
# Им же считаются псевдонимы телефонов вендоров (app.vendor_users.phone_hash) и секрет
# вебхука бота (src/telegram/webhook-secret.ts) — отдельного секрета для вебхука нет
ID_HASH_KEY=

# Ключ service_role проекта Supabase — для Storage (фото листингов). Обходит RLS
# хранилища: только на сервере. Локально — из `npx supabase status -o env`
# (SERVICE_ROLE_KEY или SECRET_KEY), на staging/production — из настроек проекта
# (Project Settings → API Keys). Адрес проекта — SUPABASE_URL в wrangler.jsonc
SUPABASE_SERVICE_ROLE_KEY=

# Токен Telegram Gateway (gateway.telegram.org) — коды входа по телефону приходят в
# Telegram. Нужен, только если в wrangler.jsonc OTP_PROVIDER = "tg_gateway"; без него
# вход по телефону в окружении выключен. Локально не нужен: там коды пишутся в лог
TELEGRAM_GATEWAY_TOKEN=

# Секрет виджета Cloudflare Turnstile (проверка «не робот» перед кодом на телефон из
# браузера, src/auth/turnstile.ts). Пусто — проверки нет. Публичный ключ того же виджета —
# TURNSTILE_SITE_KEY в wrangler.jsonc. Локально можно взять тестовую пару Cloudflare
# (секрет 1x0000000000000000000000000000000AA, ключ 1x00000000000000000000AA) — она
# принимается только при APP_ENV=local
TURNSTILE_SECRET_KEY=
